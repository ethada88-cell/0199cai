[Unit]
Description=fenliuqi Online CS API (isolated)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=ocs
Group=ocs
WorkingDirectory=/www/wwwroot/fenliuqi/app
EnvironmentFile=/www/wwwroot/fenliuqi/.env
ExecStart=/www/wwwroot/fenliuqi/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 19088 --workers 2 --limit-concurrency 200 --timeout-keep-alive 15
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
